# Owner OAuth/session configuration, server-only. Supply values locally; never use VITE_ prefixes.
APP_ORIGIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OWNER_EMAIL=
SESSION_SECRET=
# Local development only: path to a new SQLite file under .studio/.
# Not a serverless or cross-device persistence adapter.
EME_STUDIO_LOCAL_DB=

# Studio staging only; NEVER use VITE_ prefixes for these.
EME_DEPLOYMENT=
STUDIO_ORIGIN=
STUDIO_OWNER_EMAIL=
DATABASE_URL=
DATABASE_CA_CERT=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
